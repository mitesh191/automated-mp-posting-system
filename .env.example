# Mastodon: create an app token with the write:statuses scope.
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=

# Bluesky: use an app password, not your account password.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# Telegram: use a numeric chat ID or a public channel username.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@your_public_channel

# Slack: incoming webhook URL is secret and is bound to the channel you selected.
SLACK_WEBHOOK_URL=

# Discord: keep the webhook URL secret; it is bound to its destination channel.
DISCORD_WEBHOOK_URL=
