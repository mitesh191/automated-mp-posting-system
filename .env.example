# Mastodon: create an app token with the write:statuses scope.
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=

# Bluesky: use an app password, not your account password.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# LinkedIn: approved app/token scopes and author URN are required.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_VERSION=202610

# X API: use a user-context OAuth 2.0 bearer token with tweet.write.
X_USER_ACCESS_TOKEN=

# Reddit: OAuth token, subreddit name without r/, and API-compliant user agent.
REDDIT_ACCESS_TOKEN=
REDDIT_SUBREDDIT=
REDDIT_POST_TITLE=A quick update
REDDIT_USER_AGENT=automated-posting/1.0 by u/your-reddit-account
